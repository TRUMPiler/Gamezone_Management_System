
@{
    ViewData["Title"] = "Login";
}
<form method="post" action="login">
    <div id="container">
        <label>Email</label>
        <input type="email" name="Email" required/>
    </div>
    <div id="container">
        <label>Password</label>
        <input type="password" name="Password" required />
    </div>
    <input type="submit" value="Login"/>
</form>

