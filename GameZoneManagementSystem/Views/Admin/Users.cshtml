@{
    Layout = "AdminTable";
    ViewBag.Title = "Users";
}
@using GameZoneManagementSystem.Models;
 @model List<GameZoneManagementSystem.Models.User>
 <div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
      <div class="container-fluid">
        <div class="row mb-2">
          <div class="col-sm-6">
            <h1>DataTables</h1>
          </div>
          <div class="col-sm-6">
            <ol class="breadcrumb float-sm-right">
              <li class="breadcrumb-item"><a href="#">Home</a></li>
              <li class="breadcrumb-item active">DataTables</li>
            </ol>
          </div>
        </div>
      </div><!-- /.container-fluid -->
    </section>

    <!-- Main content -->
    <section class="content">
      <div class="container-fluid">
        <div class="row">
          <div class="col-12">
           
            <div class="card">
              @* <div class="card-header"> *@
              @*   <h3 class="card-title">DataTable with default features</h3> *@
              @* </div> *@
              <!-- /.card-header -->
              <div class="card-body">
                <table id="example1" class="table table-bordered table-striped">
                  <thead>
                  <tr>
                    <th>
                        ID
                    </th>
                    <th>
                        Name
                    </th>
                    <th>Email</th>
                    <th>Date of birth</th>
                    <th>PhoneNo</th>
                    <th>Gender </th>
                    <th>Role</th>
                    <th>Status</th>
                  </tr>
                  </thead>
                  <tbody>
                  @foreach(User user in Model)
                  {
                      <tr>
                          <td>@user.id</td>
                          <td>@user.Name</td>
                          <td>@user.Email</td>
                          <td>@user.Dob</td>
                          <td>@user.Phone</td>
                          <td>@user.Gender</td>
                          <td>@user.Role</td>
                          <td>@user.Status</td>
                      </tr>
                  }
                  </tbody>
                  <tfoot>
                  <tr>
                  <th>
                        ID
                    </th>
                    <th>
                        Name
                    </th>
                    <th>Email</th>
                    <th>Date of birth</th>
                    <th>PhoneNo</th>
                    <th>Gender </th>
                    <th>Role</th>
                    <th>Status</th>
                  </tr>
                  </tfoot>
                </table>
              </div>
              <!-- /.card-body -->
            </div>
            <!-- /.card -->
          </div>
          <!-- /.col -->
        </div>
        <!-- /.row -->
      </div>
      <!-- /.container-fluid -->
    </section>
    
