    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = "AdminTable";
    ViewBag.Title = "AddGames";
    
}
@model List<GameZoneManagementSystem.Models.Games_Sub_Category>

<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Add Games</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index")">Home</a></li>
                        <li class="breadcrumb-item active">Games</li>
                    </ol>
                </div>
            </div>
        </div><!-- /.container-fluid -->
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <!-- left column -->
                <div class="col-md-12">
                    <!-- jquery validation -->
                    <div class="card card-primary">
                        <div class="card-header">
                            <h3 class="card-title"> <small>Add Games</small></h3>
                        </div>
                        <!-- /.card-header -->
                        <!-- form start -->
                        <form id="quickForm" action="addGames" method="post" enctype="multipart/form-data">
                            <div class="card-body">
                                <div class="form-group">
                                    <label for="exampleInputEmail1">Game Name</label>
                                    <input type="text" name="Name" class="form-control" id="exampleInputEmail1" placeholder="Enter Game Name" required>
                                </div>
                                <div class="form-group">
                                    <label for="exampleInputPassword1">Game Description</label>
                                    <textarea name="Game_Description" class="form-control" id="exampleInputPassword1" placeholder="Enter Game Description" required></textarea>
                                </div>
                                <div class="form-group mb-0">

                                    <select name="SubCatID" class="form-control" id="exampleCheck1" required>
                                        <option value=>Select SubCategory</option>
                                            @foreach (var subCategory in Model)
                                            {
                                                <option value="@subCategory.ID">@subCategory.Sub_Category_Name - @subCategory.CategoryName</option>
                                            }
                                    </select>

                                    <div class="form-group">
                                        <label for="exampleInputEmail1">Price(in credits)</label>
                                        <input type="number" name="price" class="form-control" id="exampleInputEmail1" placeholder="Enter Game Name" required>
                                    </div>
                                    <div class="form-group">
                                        <label for="exampleInputFile">File input</label>
                                        <div class="input-group">
                                            <div class="custom-file">
                                                <input type="file" name="imageFile" class="custom-file-input" id="exampleInputFile">
                                                <label class="custom-file-label" for="exampleInputFile">Choose file</label>
                                            </div>
                                            <div class="input-group-append">
                                                <span class="input-group-text">Upload</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!-- /.card-body -->
                            <div class="card-footer">
                                <button type="submit" class="btn btn-primary">Submit</button>
                            </div>
                        </form>
                    </div>
                    <!-- /.card -->
                </div>
                <!--/.col (left) -->
                <!-- right column -->
                <div class="col-md-6">
                </div>
                <!--/.col (right) -->
            </div>
            <!-- /.row -->
        </div><!-- /.container-fluid -->
    </section>
    <!-- /.content -->

