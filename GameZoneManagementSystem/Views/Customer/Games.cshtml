@{

}
@model List<GameZoneManagementSystem.Models.Games>
@{
    Layout = "AdminTable";
    ViewBag.Title = "Games";
}
<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Games</h1>
                </div>
            </div>
        </div>
    </section>

    <section class="content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-body">
                    <table id="example1" class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Category ID</th>
                                <th>Subcategory ID</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var game in Model)
                            {
                                <tr>
                                    <td>@game.Id</td>
                                    <td>@game.Name</td>
                                    <td>@game.Description</td>
                                    <td>@game.CategoryId</td>
                                    <td>@game.SubCategoryId</td>
                                    <td>
                                        @(game.Status ? "Active" : "Inactive")
                                    </td>
                                    <td>
                                        <button class="btn btn-info" onclick="window.location='@Url.Action("EditGame", "Admin", new { id = game.Id })'">Edit</button>
                                        @if (game.Status)
                                        {
                                            <button class="btn btn-danger" onclick="window.location='@Url.Action("DeactivateGame", "Admin", new { id = game.Id })'">Deactivate</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-success" onclick="window.location='@Url.Action("ActivateGame", "Admin", new { id = game.Id })'">Activate</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Category ID</th>
                                <th>Subcategory ID</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </section>
</div>
