"@{
    ViewData["Title"] = "Login";
}
@* <link rel="stylesheet" href="~/css/register.css"/> *@

    <section class="intro-section"></section>
      <section class="featured-section">
   
     @* <div class="hero-item set-bg d-flex align-items-center justify-content-center text-center" data-setbg="@Url.Content("~/img/outside/Registeration-bg.jpg")"></div>  *@
    <div class="featured-box" style="background-image: url('@Url.Content("~/img/outside/Registeration-bg.jpg")'); background-size: cover; background-position: center; padding: 20px; border-radius: 10px;">

        <div class="form-container">        
        <form method="post" action="register" class="">

            <div class="form-group">
                    <h2 style="color: white; text-align: center;">User Registration</h2>
            </div>

            <div class="form-group">
                <label for="firstName">First Name:</label>
                <input type="text" id="firstName" name="FirstName" maxlength="15" required>
            </div>
            <div class="form-group">
                <label for="secondName">Second Name:</label>
                <input type="text" id="secondName" name="SecondName" maxlength="15">
            </div>
            <div class="form-group">
                <label for="lastName">Last Name:</label>
                <input type="text" id="lastName" name="LastName" maxlength="15">
            </div>
            <div class="form-group">
                <label for="dob">Date of Birth:</label>
                <input type="date" id="dob" name="Dob" required>
            </div>
            <div class="form-group">
                <label for="password">Password:</label>
                <input type="password" id="password" name="Password" required>
            </div>
            <div class="form-group">
                <label for="email">Email:</label>
                <input type="email" id="email" name="Email" required>
            </div>
            <div class="form-group">
                <label for="phone">Phone:</label>
                <input type="tel" id="phone" name="Phone" maxlength="10" pattern="[0-9]{10}">
            </div>
            <div class="form-group">
                <label>Gender:</label>
                <label class="radio-label" for="male">Male
                            <input type="radio" id="male" name="Gender" value="m" required>
                        </label>
                
                <label class="radio-label" for="female">Female
                            <input type="radio" id="female" name="Gender" value="F" required>
                </label>
                
                <label class="radio-label" for="other">Other
                            <input type="radio" id="other" name="Gender" value="O" required>
                </label>
            </div>
            <div class="form-group">
                <button type="submit">Register</button>
            </div>
        </form>
    
     </div>
    </div>
</section>
