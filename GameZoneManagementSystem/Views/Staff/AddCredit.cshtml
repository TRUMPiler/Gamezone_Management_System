@{
    Layout = "AdminLayout";
}
@model List<GameZoneManagementSystem.Models.User>
@if (Model.Count < 0)
{
    <p>No User Found</p>

}
else
{

    <div class="content-wrapper">
        <section class="content-header">
            <div class="container-fluid">
                <h1>Edit User</h1>
            </div>
        </section>
        <h2>Add Credit to Users</h2>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Add Credit</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>@user.Name</td>
                        <td>@user.Email</td>
                        <td>@user.Phone</td>
                        <td>
                            <form action="AddCreditToUser" method="post" class="d-flex">
                                <input type="hidden" name="userId" value="@user.id" />
                                <input type="number" name="amount" class="form-control" step="0.01" placeholder="Enter amount" required />
                                <button type="submit" class="btn btn-success ms-2">Add</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}