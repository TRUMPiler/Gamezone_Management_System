@{
    Layout = "AdminTable";
    ViewBag.Title = "Games";
}
@using GameZoneManagementSystem.Models;
@model List<GameZoneManagementSystem.Models.Games>

<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Games</h1>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-right">
                        <li class="breadcrumb-item"><a href="#">Home</a></li>
                        <li class="breadcrumb-item active">Games List</li>
                    </ol>
                </div>
            </div>
        </div>
    </section>

    <!-- Main content -->
    <section class="content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <table id="example1" class="table table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Game Name</th>
                                        <th>Description</th>
                                        <th>Sub Category Name</th>
                                        <th>Image</th>
                                        <th>Price</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (Games game in Model)
                                    {
                                        <tr>
                                            <td>@game.Id</td>
                                            <td>@game.Name</td>
                                            <td>@game.Game_Description</td>
                                            <td>@game.SubCategory.Sub_Category_Name</td>
                                            <td>
                                                <img src="@game.image" alt="Game Image" style="width: 80px; height: 80px;" />
                                            </td>
                                            <td>@game.price</td>
                                            <td>
                                                <button type="button" class="btn btn-info" onclick="window.location='@Url.Action("EditGame","Admin", new { id = game.Id })'">Edit</button>
                                                @if (game.Status) // 1 = Active
                                                {
                                                    <button type="button" class="btn btn-danger" onclick="window.location.href='@Url.Action("DeactiveGame", "Admin", new { gameid = game.Id })'">Deactive</button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="btn btn-success" onclick="window.location.href='@Url.Action("ActiveGame", "Admin", new { gameid = game.Id })'">Active</button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <th>ID</th>
                                        <th>Game Name</th>
                                        <th>Description</th>
                                        <th>Sub Category Name</th>
                                        <th>Image</th>
                                        <th>Price</th>
                                        <th>Action</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

