@{
    Layout = "AdminTable";
    ViewBag.Title = "Credit";
}
<!-- Main content -->
@using GameZoneManagementSystem.Models;
 @model List<GameZoneManagementSystem.Models.Credit>
<div class="content-wrapper">
    <section class="content-header">
        <div class="container-fluid">
            <h1>Credits</h1>
        </div>
    </section>
    <section class="content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-body">
                    <table id="example1" class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Credits</th>
                                <th>User Name</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var credit in Model)
                            {


                                <tr>
                                    <td>@credit.id</td>
                                    <td>@credit.credits.ToString()</td> <!-- currency format -->
                                    <td>@credit.UserName</td>

                                    <td>
                                        <button type="button" class="btn btn-info"
                                                onclick="window.location.href='@Url.Action("EditCredit", "Admin", new { id = credit.id })'">
                                            Edit
                                        </button>
                                        <button type="button" class="btn btn-danger"
                                                onclick="window.location.href='@Url.Action("DeleteCredit", "Admin", new { id = credit.id })'">
                                            Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th>ID</th>
                                <th>Credits</th>
                                <th>User Name</th>
                                <th>Action</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </section>
